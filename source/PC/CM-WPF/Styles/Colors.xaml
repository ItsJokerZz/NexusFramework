<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#0072CE</Color>
    <Color x:Key="PrimaryColorDark">#004B87</Color>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryColorDark}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryColorDark}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ColorPrimary" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryColorDark}" Offset="1"/>
    </LinearGradientBrush>

    <Color x:Key="GrayColor">#2A2A2A</Color>
    <Color x:Key="TextColor">#E5E7EB</Color>
    <Color x:Key="DarkColor">#0F0F0F</Color>
    <Color x:Key="DarkerColor">#161616</Color>
    <Color x:Key="DarkestColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#9CA3AF</Color>

    <Color x:Key="DarkGrayColor">#2A2A2A</Color>
    <Color x:Key="DarkTextColor">#E5E7EB</Color>
    <Color x:Key="DarkBackgroundColor">#0F0F0F</Color>
    <Color x:Key="DarkCardColor">#161616</Color>
    <Color x:Key="DarkShadowColor">#1A1A1A</Color>
    <Color x:Key="DarkTextSecondaryColor">#9CA3AF</Color>

    <Color x:Key="LightGrayColor">#E5E7EB</Color>
    <Color x:Key="LightTextColor">#374151</Color>
    <Color x:Key="LightBackgroundColor">#FFFFFF</Color>
    <Color x:Key="LightCardColor">#F9FAFB</Color>
    <Color x:Key="LightShadowColor">#F3F4F6</Color>
    <Color x:Key="LightTextSecondaryColor">#6B7280</Color>

    <SolidColorBrush x:Key="ColorGray" Color="{StaticResource GrayColor}"/>
    <SolidColorBrush x:Key="ColorText" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="ColorDark" Color="{StaticResource DarkColor}"/>
    <SolidColorBrush x:Key="ColorDarker" Color="{StaticResource DarkerColor}"/>
    <SolidColorBrush x:Key="ColorDarkest" Color="{StaticResource DarkestColor}"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="{StaticResource TextSecondaryColor}"/>

    <LinearGradientBrush x:Key="CardBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A2A2A" Offset="0"/>
        <GradientStop Color="#1A1A1A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DarkCardBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A2A2A" Offset="0"/>
        <GradientStop Color="#1A1A1A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LightCardBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E5E7EB" Offset="0"/>
        <GradientStop Color="#D1D5DB" Offset="1"/>
    </LinearGradientBrush>
    
</ResourceDictionary> 