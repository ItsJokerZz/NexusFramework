<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BlurOverlay" TargetType="Border">
        <Setter Property="Background" Value="#80000000"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="OverlayPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ColorDarker}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorGray}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Width" Value="800"/>
        <Setter Property="MaxHeight" Value="600"/>
        <Setter Property="Margin" Value="20"/>
    </Style>

    <Style x:Key="ConsoleItem" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ColorDarker}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Margin" Value="16,0,16,8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryGradient}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary> 