<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SidebarPanel" TargetType="DockPanel">
        <Setter Property="Background" Value="{DynamicResource ColorDark}"/>
        <Setter Property="MinWidth" Value="250"/>
    </Style>


    <Style x:Key="HeaderContainer" TargetType="Grid">
        <Setter Property="Height" Value="80"/>
        <Setter Property="Background" Value="{DynamicResource ColorDarkest}"/>
    </Style>


    <Style x:Key="IconContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ColorDarker}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    
</ResourceDictionary> 