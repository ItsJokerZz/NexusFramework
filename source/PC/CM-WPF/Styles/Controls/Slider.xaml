<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SliderRepeatButton" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <!-- Shadow effect -->
                        <Border Background="#20000000"
                                Width="20" Height="20"
                                CornerRadius="10"
                                Margin="-10,-7,0,0">
                            <Border.Effect>
                                <BlurEffect Radius="4"/>
                            </Border.Effect>
                        </Border>
                        <!-- Thumb circle -->
                        <Border Background="{DynamicResource ColorPrimary}"
                                Width="18" Height="18"
                                CornerRadius="9"
                                Margin="-9,-6,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#40000000" 
                                                BlurRadius="4" 
                                                ShadowDepth="2"
                                                Direction="270"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkSlider" TargetType="Slider">
        <Setter Property="Background" Value="{DynamicResource ColorGray}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorGray}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Tick marks -->
                        <TickBar x:Name="TopTick" 
                                Height="4"
                                Fill="{DynamicResource ColorGray}"
                                Placement="Top"
                                Visibility="Collapsed"
                                Grid.Row="0"/>

                        <Grid Grid.Row="1">
                            <!-- Background track -->
                            <Border x:Name="TrackBackground" 
                                    Height="4" 
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="2"
                                    Opacity="0.3"/>
                            
                            <!-- Foreground track -->
                            <Border x:Name="PART_SelectionRange"
                                    Height="4"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left">
                                <Border.Effect>
                                    <DropShadowEffect Color="#40000000" 
                                                    BlurRadius="4" 
                                                    ShadowDepth="1"
                                                    Direction="270"/>
                                </Border.Effect>
                            </Border>

                            <!-- Track with thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" 
                                                Style="{StaticResource SliderRepeatButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" 
                                                Style="{StaticResource SliderRepeatButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TickPlacement" Value="TopLeft">
                            <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary> 