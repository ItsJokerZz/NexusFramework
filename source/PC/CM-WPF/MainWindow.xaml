<Window x:Class="ConsoleManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConsoleManager"
        xmlns:converters="clr-namespace:ConsoleManager.Converters"
        mc:Ignorable="d"
        Title="GoldHEN Console Manager" 
        MinWidth="1024" 
        MinHeight="768"
        Width="1280" 
        Height="425"
        Background="{DynamicResource ColorDarker}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:PercentageToWidthConverter x:Key="PercentageToWidthConverter"/>
        <Geometry x:Key="DiskIcon">M20 13V6C20 4.89543 19.1046 4 18 4H6C4.89543 4 4 4.89543 4 6V13M20 13V18C20 19.1046 19.1046 20 18 20H6C4.89543 20 4 19.1046 4 18V13M20 13H4M8 17H16</Geometry>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Style="{StaticResource SidebarPanel}">
            <DockPanel DockPanel.Dock="Top" Margin="16,16,16,8" Width="222">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Style="{StaticResource IconContainer}" Margin="0,0,0,0" Padding="8">
                        <Path Data="{StaticResource MonitorIcon}" 
                              Stroke="{DynamicResource PrimaryGradient}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="24" Height="24"
                              Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Consoles" 
                             Style="{StaticResource SectionTitle}"
                             Margin="12,0,0,0"/>
                </StackPanel>

                <Button x:Name="AddConsoleButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}"
                        Click="ShowAddConsoleOverlay_Click" RenderTransformOrigin="0.5,0.5" Width="101">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="-1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                    <Path Data="{StaticResource PlusIcon}" 
                          Fill="{DynamicResource ColorText}"
                          Width="24" Height="24"/>
                </Button>
            </DockPanel>

            <ScrollViewer DockPanel.Dock="Top" 
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,8,0,0">
                <StackPanel x:Name="ConsoleList">
                    <TextBlock x:Name="EmptyState"
                              Text="You have no consoles added."
                              Foreground="{DynamicResource ColorTextSecondary}"
                              HorizontalAlignment="Center"
                              Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <ScrollViewer Grid.Column="1" 
                     HorizontalScrollBarVisibility="Disabled" 
                     VerticalScrollBarVisibility="Auto">
            <DockPanel>
                <Grid Style="{StaticResource HeaderContainer}" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GoldHEN Console Manager" 
                                  Style="{StaticResource HeaderText}"/>
                        <TextBlock Text="Powered by OrbisControl and Made by ItsJokerZz" 
                                  Style="{StaticResource SubheaderText}"/>
                    </StackPanel>

                    <Canvas x:Name="SignalCanvas" 
                            Grid.Column="1"
                            Width="24" Height="24" 
                            Margin="0,0,20,0">
                        <Path x:Name="SignalBar1" 
                              Data="{StaticResource SignalBar1}" 
                              Stroke="{DynamicResource PrimaryGradient}" 
                              StrokeThickness="2"/>
                        <Path x:Name="SignalBar2" 
                              Data="{StaticResource SignalBar2}" 
                              Stroke="{DynamicResource PrimaryGradient}" 
                              StrokeThickness="2"/>
                        <Path x:Name="SignalBar3" 
                              Data="{StaticResource SignalBar3}" 
                              Stroke="{DynamicResource PrimaryGradient}" 
                              StrokeThickness="2"/>
                        <Path x:Name="SignalBar4" 
                              Data="{StaticResource SignalBar4}" 
                              Stroke="{DynamicResource PrimaryGradient}" 
                              StrokeThickness="2"/>
                        <Path x:Name="SignalBar5" 
                              Data="{StaticResource SignalBar5}" 
                              Stroke="{DynamicResource PrimaryGradient}" 
                              StrokeThickness="2"/>
                    </Canvas>
                </Grid>

                <TabControl Style="{StaticResource MainTabControl}">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="24,8"/>
                            <Setter Property="Margin" Value="32,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" 
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0,0,0,2"
                                                BorderBrush="Transparent"
                                                CornerRadius="4,4,0,0">
                                            <ContentPresenter x:Name="ContentSite"
                                                            ContentSource="Header"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryGradient}"/>
                                                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource PrimaryGradient}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource ColorTextSecondary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="Home" Height="43" VerticalAlignment="Center" Margin="0,0,-1,0">
                        <Border Style="{StaticResource ContainerBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- System Info Card -->
                                <Border Style="{StaticResource CardBorder}" 
                                        Grid.Row="0" Grid.Column="0" 
                                        Margin="0,0,8,8">
                                    <DockPanel MinWidth="400" MinHeight="180">
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                            <TextBlock Text="System Info" 
                                                      Style="{StaticResource CardTitle}"
                                                      FontSize="18"/>
                                            <Button Style="{StaticResource IconButton}" 
                                                    HorizontalAlignment="Right"
                                                    Click="RefreshSystemInfo_Click">
                                                <Path Data="{StaticResource RefreshIcon}" 
                                                      Fill="{DynamicResource ColorText}"
                                                      Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Firmware" 
                                                          Style="{StaticResource CardLabel}"
                                                          FontSize="13"/>
                                                <TextBlock Text="{Binding FirmwareVersion}" 
                                                          Style="{StaticResource CardValue}"
                                                          FontSize="16"
                                                          Margin="0,4,0,16"/>

                                                <TextBlock Text="CPU" 
                                                          Style="{StaticResource CardLabel}"
                                                          FontSize="13"/>
                                                <TextBlock Text="{Binding CPUTemperature}" 
                                                          Style="{StaticResource CardValue}"
                                                          FontSize="16"
                                                          Margin="0,4,0,16"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Type" 
                                                          Style="{StaticResource CardLabel}"
                                                          FontSize="13"/>
                                                <TextBlock Text="{Binding ConsoleType}" 
                                                          Style="{StaticResource CardValue}"
                                                          FontSize="16"
                                                          Margin="0,4,0,16"/>

                                                <TextBlock Text="SoC" 
                                                          Style="{StaticResource CardLabel}"
                                                          FontSize="13"/>
                                                <TextBlock Text="{Binding SoCTemperature}" 
                                                          Style="{StaticResource CardValue}"
                                                          FontSize="16"
                                                          Margin="0,4,0,16"/>
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <!-- Quick Actions Card -->
                                <Border Style="{StaticResource CardBorder}" 
                                        Grid.Row="0" Grid.Column="1" 
                                        Margin="8,0,0,8">
                                    <DockPanel MinWidth="400" MinHeight="180">
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                            <TextBlock Text="Quick Actions" 
                                                      Style="{StaticResource CardTitle}"
                                                      FontSize="18"/>
                                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right">
                                                <Path Data="{StaticResource PowerIcon}" 
                                                      Fill="{DynamicResource ColorText}"
                                                      Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Stretch">
                                            <Button Content="Restart System" 
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    FontSize="13"
                                                    Height="34"
                                                    Margin="0,0,0,8"/>
                                            <Button Content="Quick Boot" 
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    FontSize="13"
                                                    Height="34"
                                                    Margin="0,0,0,8"/>
                                            <Button Content="Shutdown" 
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    FontSize="13"
                                                    Height="34"
                                                    Margin="0,0,0,8"/>
                                            <Button Content="Hard Reset" 
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    FontSize="13"
                                                    Height="34"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Disk Info Card -->
                                <Border Style="{StaticResource CardBorder}" 
                                        Grid.Row="1" Grid.Column="0" 
                                        Margin="0,8,8,0">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                            <TextBlock Text="Storage Info" 
                                                      Style="{StaticResource CardTitle}"
                                                      FontSize="18"/>
                                            <Button Style="{StaticResource IconButton}" 
                                                    HorizontalAlignment="Right"
                                                   >
                                                <Path Data="{StaticResource DiskIcon}" 
                                                      Fill="{DynamicResource ColorText}"
                                                      Width="14" Height="14"/>
                                            </Button>
                                        </Grid>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Progress Bar -->
                                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="Storage Usage" 
                                                             Style="{StaticResource CardLabel}"
                                                             FontSize="12"/>
                                                    <TextBlock Text="{Binding DiskUsagePercentage, StringFormat={}{0}%}" 
                                                             Style="{StaticResource CardValue}"
                                                             FontSize="12"
                                                             HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid x:Name="ProgressBarContainer">
                                                    <Border Height="8" 
                                                            Background="#1a1a1a" 
                                                            CornerRadius="4"/>
                                                    <Border Height="8" 
                                                            Background="{DynamicResource PrimaryGradient}" 
                                                            CornerRadius="4" 
                                                            HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                                <Binding Path="DiskUsagePercentage"/>
                                                                <Binding ElementName="ProgressBarContainer" Path="ActualWidth"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Disk Stats -->
                                            <UniformGrid Grid.Row="1" Columns="3">
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="Free Space" 
                                                             Style="{StaticResource CardLabel}"
                                                             FontSize="12"/>
                                                    <TextBlock Text="{Binding FreeDiskSpace}" 
                                                             Style="{StaticResource CardValue}"
                                                             FontSize="14"
                                                             Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel Margin="8,0,8,0">
                                                    <TextBlock Text="Total Space" 
                                                              Style="{StaticResource CardLabel}"
                                                              FontSize="12"/>
                                                    <TextBlock Text="{Binding TotalDiskSpace}" 
                                                              Style="{StaticResource CardValue}"
                                                              FontSize="14"
                                                              Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel Margin="16,0,0,0">
                                                    <TextBlock Text="Used Space" 
                                                              Style="{StaticResource CardLabel}"
                                                              FontSize="12"/>
                                                    <TextBlock Text="{Binding UsedDiskSpace}" 
                                                              Style="{StaticResource CardValue}"
                                                              FontSize="14"
                                                              Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </UniformGrid>
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <!-- Versioning Card -->
                                <Border Style="{StaticResource CardBorder}" 
                                        Grid.Row="1" Grid.Column="1" 
                                        Margin="8,8,0,0">
                                    <DockPanel>
                                        <TextBlock Text="Versioning" 
                                                  Style="{StaticResource CardTitle}"
                                                  FontSize="18"
                                                  DockPanel.Dock="Top"
                                                  Margin="0,0,0,16"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- DLL Version -->
                                            <Border Style="{StaticResource CardBorder}" 
                                                    Grid.Column="0"
                                                    Margin="0,0,8,0">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                                        <TextBlock Text="DLL Version" 
                                                                  Style="{StaticResource CardTitle}"
                                                                  FontSize="14"/>
                                                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right">
                                                            <Path Data="{StaticResource CubeIcon}" 
                                                                  Fill="{DynamicResource ColorText}"
                                                                  Width="12" Height="12"/>
                                                        </Button>
                                                    </Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="Current Version" 
                                                                  Style="{StaticResource CardLabel}"
                                                                  FontSize="12"/>
                                                        <TextBlock Text="{Binding DLLVersion}" 
                                                                  Style="{StaticResource CardValue}"
                                                                  FontSize="14"
                                                                  Margin="0,2,0,8"/>
                                                        <TextBlock Text="Build Date" 
                                                                  Style="{StaticResource CardLabel}"
                                                                  FontSize="12"/>
                                                        <TextBlock Text="????.??.??" 
                                                                  Style="{StaticResource CardValue}"
                                                                  FontSize="14"
                                                                  Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- PRX Version -->
                                            <Border Style="{StaticResource CardBorder}" 
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                                        <TextBlock Text="PRX Version" 
                                                                  Style="{StaticResource CardTitle}"
                                                                  FontSize="14"/>
                                                        <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right">
                                                            <Path Data="{StaticResource DocumentIcon}" 
                                                                  Fill="{DynamicResource ColorText}"
                                                                  Width="12" Height="12"/>
                                                        </Button>
                                                    </Grid>
                                                    <StackPanel>
                                                        <TextBlock 
                                                                  Style="{StaticResource CardLabel}"
                                                                  FontSize="12" Text="Current Version"/>
                                                        <TextBlock Text="{Binding PRXVersion}" 
                                                                  Style="{StaticResource CardValue}"
                                                                  FontSize="14"
                                                                  Margin="0,2,0,8"/>
                                                        <TextBlock Text="Build Date" 
                                                                  Style="{StaticResource CardLabel}"
                                                                  FontSize="12"/>
                                                        <TextBlock Text="????.??.??" 
                                                                  Style="{StaticResource CardValue}"
                                                                  FontSize="14"
                                                                  Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="System" Margin="10,0,0,0" HorizontalAlignment="Left" Width="67">
                        <Border Style="{StaticResource ContainerBorder}">
                            <Grid>
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Style="{StaticResource CardBorder}" Grid.Row="0">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                                    <TextBlock Text="System Management" Style="{StaticResource CardTitle}"/>
                                                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right">
                                                        <Path Data="{StaticResource ThermometerIcon}" 
                                                              Fill="{DynamicResource ColorText}"
                                                              Width="14" Height="14"/>
                                                    </Button>
                                                </Grid>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0">
                                                        <!-- Fan Threshold Section -->
                                                        <Grid Margin="0,0,0,24">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                                <TextBlock Text="Fan Threshold" 
                                                                          Foreground="{DynamicResource ColorTextSecondary}"
                                                                          FontSize="14"
                                                                          HorizontalAlignment="Left"/>
                                                                <TextBlock Text="{Binding Value, ElementName=FanThresholdSlider, StringFormat={}{0:0}°C}"
                                                                          Foreground="{DynamicResource ColorText}"
                                                                          FontSize="14"
                                                                          HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            
                                                            <Grid Grid.Row="1" Height="28">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="60"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Slider x:Name="FanThresholdSlider"
                                                                        Grid.Column="0"
                                                                        Minimum="50"
                                                                        Maximum="85"
                                                                        Value="70"
                                                                        TickFrequency="5"
                                                                        IsSnapToTickEnabled="True"
                                                                        Style="{StaticResource DarkSlider}"
                                                                        VerticalAlignment="Center"/>
                                                                <Button Content="Set"
                                                                        Grid.Column="2"
                                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                                        Height="28"
                                                                        Click="SetFanThreshold_Click"/>
                                                            </Grid>
                                                        </Grid>

                                                        <!-- Console Buzzer Section -->
                                                        <Grid Margin="0,0,0,24">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <TextBlock Text="Console Buzzer" 
                                                                      Grid.Row="0"
                                                                      Foreground="{DynamicResource ColorTextSecondary}"
                                                                      FontSize="14"
                                                                      Margin="0,0,0,8"/>
                                                            
                                                            <Grid Grid.Row="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="120"/>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <StackPanel Grid.Column="0" 
                                                                            Orientation="Horizontal">
                                                                    <RadioButton Content="Single" 
                                                                                IsChecked="True" 
                                                                                Margin="0,0,16,0"/>
                                                                    <RadioButton Content="Double" 
                                                                                Margin="0,0,16,0"/>
                                                                    <RadioButton Content="Triple" 
                                                                                Margin="0,0,16,0"/>
                                                                    <RadioButton Content="Continuous"/>
                                                                </StackPanel>
                                                                
                                                                <Button Content="Activate Buzzer"
                                                                        Grid.Column="2"
                                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                                        Height="28"/>
                                                            </Grid>
                                                        </Grid>
                                                    </StackPanel>

                                                    <Grid Grid.Row="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="System Power" 
                                                                 Foreground="{DynamicResource ColorTextSecondary}"
                                                                 FontSize="14"
                                                                 Margin="0,0,0,8"/>
                                                        <UniformGrid Grid.Row="1" Rows="2" Columns="2">
                                                            <Button Content="Restart System" 
                                                                    Style="{StaticResource ActionButtonStyle}"
                                                                    Margin="0,0,8,8"/>
                                                            <Button Content="Enter Rest Mode"
                                                                    Style="{StaticResource ActionButtonStyle}"
                                                                    Margin="8,0,0,8"/>
                                                            <Button Content="Soft Reboot"
                                                                    Style="{StaticResource ActionButtonStyle}"
                                                                    Margin="0,8,8,0"/>
                                                            <Button Content="Shutdown"
                                                                    Style="{StaticResource ActionButtonStyle}"
                                                                    Margin="8,8,0,0"/>
                                                        </UniformGrid>
                                                    </Grid>
                                                </Grid>
                                            </DockPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardBorder}" Grid.Row="1" Margin="0,20,0,0">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                                    <TextBlock Style="{StaticResource CardTitle}"><Run Text="Send Notifications"/><LineBreak/><Run/></TextBlock>
                                                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right">
                                                        <Path Data="{StaticResource BellIcon}" 
                                                              Fill="{DynamicResource ColorText}"
                                                              Width="14" Height="14"/>
                                                    </Button>
                                                </Grid>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                                        <ComboBox Style="{StaticResource DarkComboBox}">
                                                            <ComboBoxItem Content="Select Image Type" Style="{StaticResource DarkComboBoxItem}"/>
                                                            <ComboBoxItem Content="System Image" Style="{StaticResource DarkComboBoxItem}"/>
                                                            <ComboBoxItem Content="Custom Image" Style="{StaticResource DarkComboBoxItem}"/>
                                                        </ComboBox>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="120"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0"
                                                                     Tag="Enter text here..."
                                                                     Style="{StaticResource DarkTextBox}"
                                                                     Margin="0,0,8,0"/>
                                                            <Button Content="Send"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource PrimaryButtonStyle}"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="120"/>
                                                            </Grid.ColumnDefinitions>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Memory" Margin="12,0,-29,0">
                        <Border Style="{StaticResource ContainerBorder}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                         HorizontalScrollBarVisibility="Disabled"
                                         >
                                <StackPanel MinWidth="700">

                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Module Loader" Style="{StaticResource CardTitle}"/>

                                            <StackPanel Margin="0,0,0,16">
                                                <TextBlock Text="Process:"
                                                          Foreground="{DynamicResource ColorTextSecondary}"
                                                          Margin="0,0,0,4"/>
                                                <ComboBox x:Name="ProcessListComboBox"
                                                         Style="{StaticResource DarkComboBox}"
                                                         Margin="0,0,8,0"
                                                         SelectionChanged="ProcessList_SelectionChanged"
                                                         IsEditable="True"
                                                         IsTextSearchEnabled="True"
                                                         TextSearch.TextPath="Content"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,16">
                                                <TextBlock Text="Module Path:" 
                                                         Foreground="#888888" 
                                                         FontSize="12" 
                                                         Margin="0,0,0,8"/>
                                                <TextBox Tag="/data/plugins/example.prx"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Foreground="{DynamicResource ColorText}"
                                                         CaretBrush="{DynamicResource ColorText}"/>
                                            </StackPanel>

                                            <Button Content="Load Module" 
                                                    Style="{StaticResource PrimaryButtonStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Plugin Loader" Style="{StaticResource CardTitle}"/>

                                            <StackPanel Margin="0,0,0,16">
                                                <TextBlock Text="Plugin Path:" 
                                                         Foreground="#888888" 
                                                         FontSize="12" 
                                                         Margin="0,0,0,8"/>
                                                <TextBox Tag="/data/plugins/example.prx"
                                                         Style="{StaticResource DarkTextBox}"
                                                         Foreground="{DynamicResource ColorText}"
                                                         CaretBrush="{DynamicResource ColorText}"/>
                                            </StackPanel>
                                            
                                            <Button Content="Load Plugin" 
                                                    Style="{StaticResource PrimaryButtonStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Loaded PRX" Style="{StaticResource CardTitle}"/>
                                            
                                            <!-- Loaded Modules Card -->
                                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Loaded Modules" Style="{StaticResource CardTitle}"/>
                                                    <TextBlock Text="No modules loaded" 
                                                             Foreground="#888888"
                                                             FontSize="14"
                                                             HorizontalAlignment="Center"
                                                             Margin="0,20"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Loaded Plugins Card -->
                                            <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Loaded Plugins" Style="{StaticResource CardTitle}"/>
                                                    <TextBlock Text="No plugins loaded" 
                                                             Foreground="#888888"
                                                             FontSize="14"
                                                             HorizontalAlignment="Center"
                                                             Margin="0,20"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <TabItem Header="Settings" Margin="29,0,-59,0">
                        <Grid>
                            <Border Style="{StaticResource ContainerBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource CardBorder}" Grid.Row="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                                <TextBlock Text="Theme Settings" 
                                                         Style="{StaticResource CardTitle}"
                                                         FontSize="18"/>
                                                <Button Style="{StaticResource IconButton}"
                                                        HorizontalAlignment="Right"
                                                        Padding="12"
                                                        Margin="8"
                                                        Click="ToggleDarkMode_Click">
                                                    <Path Data="{StaticResource MoonIcon}" 
                                                          Fill="{DynamicResource ColorText}"
                                                          Width="14" Height="14"/>
                                                </Button>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                     Text="Customize the appearance of your console manager by adjusting the color scheme below."
                                                     Foreground="{DynamicResource ColorTextSecondary}"
                                                     TextWrapping="Wrap"
                                                     FontSize="13"
                                                     Margin="0,0,0,16"/>

                                            <StackPanel Grid.Row="2">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="0.2*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="24" Height="24" 
                                                            Background="{DynamicResource PrimaryGradient}"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand"
                                                            MouseDown="ColorBox_MouseDown"/>
                                                    <TextBlock Grid.Column="1"
                                                             Text="#0070D1" 
                                                             Foreground="{DynamicResource ColorText}"
                                                             VerticalAlignment="Center"
                                                             FontSize="13"
                                                             Margin="12,0,24,0"/>
                                                    <TextBlock Grid.Column="2"
                                                             Text="Primary color used for buttons and interactive elements"
                                                             Foreground="{DynamicResource ColorTextSecondary}"
                                                             TextWrapping="Wrap"
                                                             FontSize="13"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="0.2*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="24" Height="24" 
                                                            Background="{DynamicResource ColorDark}"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand"
                                                            MouseDown="ColorBox_MouseDown"/>
                                                    <TextBlock Grid.Column="1"
                                                             Text="#0F0F0F" 
                                                             Foreground="{DynamicResource ColorText}"
                                                             VerticalAlignment="Center"
                                                             FontSize="13"
                                                             Margin="12,0,24,0"/>
                                                    <TextBlock Grid.Column="2"
                                                             Text="Main background color of the application"
                                                             Foreground="{DynamicResource ColorTextSecondary}"
                                                             TextWrapping="Wrap"
                                                             FontSize="13"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="0.2*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="24" Height="24" 
                                                            Background="{DynamicResource ColorDarker}"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand"
                                                            MouseDown="ColorBox_MouseDown"/>
                                                    <TextBlock Grid.Column="1"
                                                             Text="#161616" 
                                                             Foreground="{DynamicResource ColorText}"
                                                             VerticalAlignment="Center"
                                                             FontSize="13"
                                                             Margin="12,0,24,0"/>
                                                    <TextBlock Grid.Column="2"
                                                             Text="Background color for cards and panels"
                                                             Foreground="{DynamicResource ColorTextSecondary}"
                                                             TextWrapping="Wrap"
                                                             FontSize="13"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="0.2*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="24" Height="24" 
                                                            Background="{DynamicResource ColorDarkest}"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand"
                                                            MouseDown="ColorBox_MouseDown"/>
                                                    <TextBlock Grid.Column="1"
                                                             Text="#1A1A1A" 
                                                             Foreground="{DynamicResource ColorText}"
                                                             VerticalAlignment="Center"
                                                             FontSize="13"
                                                             Margin="12,0,24,0"/>
                                                    <TextBlock Grid.Column="2"
                                                             Text="Used for the darkest elements and shadows"
                                                             Foreground="{DynamicResource ColorTextSecondary}"
                                                             TextWrapping="Wrap"
                                                             FontSize="13"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="0.2*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="24" Height="24" 
                                                            Background="{DynamicResource ColorGray}"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand"
                                                            MouseDown="ColorBox_MouseDown"/>
                                                    <TextBlock Grid.Column="1"
                                                             Text="#2A2A2A" 
                                                             Foreground="{DynamicResource ColorText}"
                                                             VerticalAlignment="Center"
                                                             FontSize="13"
                                                             Margin="12,0,24,0"/>
                                                    <TextBlock Grid.Column="2"
                                                             Text="Used for borders and separators"
                                                             Foreground="{DynamicResource ColorTextSecondary}"
                                                             TextWrapping="Wrap"
                                                             FontSize="13"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="0.2*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="24" Height="24" 
                                                            Background="{DynamicResource ColorText}"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand"
                                                            MouseDown="ColorBox_MouseDown"/>
                                                    <TextBlock Grid.Column="1"
                                                             Text="#E5E7EB" 
                                                             Foreground="{DynamicResource ColorText}"
                                                             VerticalAlignment="Center"
                                                             FontSize="13"
                                                             Margin="12,0,24,0"/>
                                                    <TextBlock Grid.Column="2"
                                                             Text="Primary text color throughout the application"
                                                             Foreground="{DynamicResource ColorTextSecondary}"
                                                             TextWrapping="Wrap"
                                                             FontSize="13"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="0.2*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="24" Height="24" 
                                                            Background="{DynamicResource ColorTextSecondary}"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand"
                                                            MouseDown="ColorBox_MouseDown"/>
                                                    <TextBlock Grid.Column="1"
                                                             Text="#9CA3AF" 
                                                             Foreground="{DynamicResource ColorText}"
                                                             VerticalAlignment="Center"
                                                             FontSize="13"
                                                             Margin="12,0,24,0"/>
                                                    <TextBlock Grid.Column="2"
                                                             Text="Used for less prominent text and labels"
                                                             Foreground="{DynamicResource ColorTextSecondary}"
                                                             TextWrapping="Wrap"
                                                             FontSize="13"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>

                                            <Grid Grid.Row="3" Margin="0,16,0,0">
                                                <Button Content="Reset to Default" 
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        HorizontalAlignment="Left"
                                                        FontSize="13"
                                                        Height="34"
                                                        Width="110"
                                                        Click="ResetToDefault_Click"/>
                                                <Button Content="Save Changes" 
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        HorizontalAlignment="Right"
                                                        FontSize="13"
                                                        Height="34"
                                                        Width="110"
                                                        Click="SaveChanges_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </ScrollViewer>

        <Grid x:Name="AddConsoleOverlay" 
              Visibility="Collapsed"
              Panel.ZIndex="9999"
              Grid.ColumnSpan="2">

            <Border Background="#80000000"
                    MouseDown="OverlayBackground_MouseDown"/>

            <Border Style="{StaticResource OverlayPanel}"
                    Width="800"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,20,20,0">
                        <StackPanel>
                            <TextBlock Text="Add a New Console"
                                     FontSize="20"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource ColorText}"/>
                            <TextBlock Text="Add manually or scan your network"
                                     FontSize="13"
                                     Margin="0,4,0,0"
                                     Foreground="{DynamicResource ColorTextSecondary}"/>
                        </StackPanel>
                        <Button Style="{StaticResource CloseButton}"
                                HorizontalAlignment="Right"
                                Click="CloseAddConsoleOverlay_Click"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Manual Setup"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Margin="0,0,0,24"
                                     Foreground="{DynamicResource ColorText}"/>

                            <TextBlock Text="Console Name"
                                     Margin="0,0,0,8"
                                     Foreground="{DynamicResource ColorTextSecondary}"/>
                            <TextBox x:Name="ConsoleNameTextBox"
                                     Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,24"/>

                            <TextBlock Text="IP Address"
                                     Margin="0,0,0,8"
                                     Foreground="{DynamicResource ColorTextSecondary}"/>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Found Consoles"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Margin="0,0,0,24"
                                     Foreground="{DynamicResource ColorText}"/>

                            <ScrollViewer MaxHeight="400" 
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="FoundConsolesPanel" Margin="0,0,12,0"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="20">
                        <Button Content="Add Console"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Width="120"
                                Click="AddConsole_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="RenameOverlay" 
              Visibility="Collapsed"
              Panel.ZIndex="9999"
              Grid.ColumnSpan="2">

            <Border Background="#80000000"
                    MouseDown="OverlayBackground_MouseDown"/>

            <Border Style="{StaticResource OverlayPanel}"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,20,20,0">
                        <TextBlock Text="Rename Console"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ColorText}"/>
                        <Button Style="{StaticResource CloseButton}"
                                HorizontalAlignment="Right"
                                Click="CloseRenameOverlay_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="20">
                        <TextBlock Text="Console Name"
                                 Margin="0,0,0,8"
                                 Foreground="{DynamicResource ColorTextSecondary}"/>
                        <TextBox x:Name="RenameTextBox"
                                 Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="20">
                        <Button Content="Rename"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Width="100"
                                Click="ConfirmRename_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


