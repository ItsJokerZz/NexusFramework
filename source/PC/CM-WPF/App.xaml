<Application x:Class="ConsoleManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ConsoleManager"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Icons.xaml"/>
                <ResourceDictionary Source="Styles/Borders.xaml"/>
                <ResourceDictionary Source="Styles/Controls/Buttons.xaml"/>
                <ResourceDictionary Source="Styles/Controls/Scrollbar.xaml"/>
                <ResourceDictionary Source="Styles/Controls/ScrollViewer.xaml"/>
                <ResourceDictionary Source="Styles/Controls/TabControl.xaml"/>
                <ResourceDictionary Source="Styles/Controls/Cards.xaml"/>
                <ResourceDictionary Source="Styles/Controls/TextBox.xaml"/>
                <ResourceDictionary Source="Styles/Controls/ComboBox.xaml"/>
                <ResourceDictionary Source="Styles/Controls/RadioButton.xaml"/>
                <ResourceDictionary Source="Styles/Controls/Containers.xaml"/>
                <ResourceDictionary Source="Styles/Controls/TextBlock.xaml"/>
                <ResourceDictionary Source="Styles/Controls/Overlay.xaml"/>
                <ResourceDictionary Source="Styles/Controls/ContextMenu.xaml"/>
                <ResourceDictionary Source="Styles/Controls/Slider.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:IndexToVisibilityConverter x:Key="IndexToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
